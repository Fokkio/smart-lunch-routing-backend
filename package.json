{
  "name": "smart-lunch-routing-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Express + TypeScript + TiDB Cloud MySQL-compatible backend for smart-lunch-routing.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/run-sql.ts database/migrations/001_initial_schema.sql",
    "db:migrate:routing": "tsx scripts/run-sql.ts database/migrations/002_routing_metadata.sql",
    "db:migrate:simulation": "tsx scripts/run-sql.ts database/migrations/003_simulated_orders.sql",
    "db:migrate:cost-formula": "tsx scripts/run-sql.ts database/migrations/004_rider_cost_formula.sql",
    "db:migrate:accounts": "tsx scripts/migrate-accounts.ts",
    "db:migrate:review": "tsx scripts/migrate-review.ts",
    "db:create-owner": "tsx scripts/create-owner.ts",
    "db:prune-drafts": "tsx scripts/prune-draft-plans.ts",
    "db:seed": "tsx scripts/init-shop-settings.ts",
    "verify:live-osrm": "tsx scripts/live-verify-osrm.ts",
    "db:init-settings": "tsx scripts/init-shop-settings.ts",
    "db:clear": "tsx scripts/clear-database.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "~5.6.2",
    "vitest": "^4.0.8"
  }
}
