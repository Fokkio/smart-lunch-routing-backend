# Copy to backend/.env and fill in the blanks (never commit real values).
PORT=3000

# --- Aiven MySQL (required — no localhost fallback) ---
# Fill these from your Aiven service overview page.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb

# --- Aiven SSL (required when DB_SSL=true) ---
# Download the Aiven CA certificate and save it as backend/certs/ca.pem.
# Run backend commands from the backend/ directory so this relative path resolves.
DB_SSL=true
DB_SSL_CA_PATH=./certs/ca.pem

# --- Development conveniences ---
# CORS origin for the Angular dev server.
CORS_ORIGIN=http://localhost:4200
# Public OSRM demo server: development convenience only, NOT production infrastructure.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=10000
