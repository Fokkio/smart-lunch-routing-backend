PORT=3000

# --- TiDB Cloud MySQL-compatible runtime database ---
# Use the application user, not root/admin, for normal backend runtime.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=smart_lunch_route

# --- TiDB Cloud TLS ---
# Use either DB_SSL_CA for deployment platforms or DB_SSL_CA_PATH locally.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CA_PATH=./certs/isrgrootx1.pem
DB_CONNECTION_LIMIT=2

CORS_ORIGIN=http://localhost:4200,https://smart-lunch-api.f0kki0.me,https://smart-lunch-routing.f0kki0.me/
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000
